# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and only used for local development.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
# The public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon key (safe to expose to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# The service role key — NEVER expose this to the browser.
# Only used in trusted server-side contexts (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Email (Resend) ---------------------------------------------------------
# Found in: Resend Dashboard > API Keys
RESEND_API_KEY=your_resend_api_key
# Default "from" address used for transactional email when a business
# has not configured its own sender. Each tenant can override this in Settings.
DEFAULT_FROM_EMAIL=Nelsobral@gmail.com

# --- App --------------------------------------------------------------------
# The public base URL of the app. Used for auth redirects and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
